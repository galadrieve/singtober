#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = [
#   "markdown-it-py",
#   "mdformat",
#   "mdformat-gfm-alerts",
#   "ruamel.yaml",
#   "tomlkit",
# ]
